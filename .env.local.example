# Copy this file to `.env.local` and fill in real values (DO NOT commit `.env.local`).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key-here
SUPABASE_SERVICE_ROLE=service-role-key-here # server-side only

# Stripe (test keys)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Site URL used for redirecting after Checkout
NEXT_PUBLIC_SITE_URL=http://localhost:3000
